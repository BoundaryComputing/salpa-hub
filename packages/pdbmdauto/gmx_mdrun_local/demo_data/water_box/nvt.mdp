; NVT Equilibration MDP file for GROMACS
; Short equilibration at constant temperature (300K)
;
; Reference: GROMACS 2024 documentation
; https://manual.gromacs.org/current/user-guide/mdp-options.html

; Run control
integrator      = md            ; Leap-frog integrator
dt              = 0.002         ; 2 fs time step
nsteps          = 5000          ; 10 ps total (5000 * 2fs)

; Output control
nstlog          = 500           ; Write to log every 1 ps
nstenergy       = 500           ; Write energies every 1 ps
nstxout-compressed = 500        ; Write coordinates every 1 ps
compressed-x-grps = System      ; Compress all atoms

; Neighbor searching
cutoff-scheme   = Verlet
nstlist         = 10
ns_type         = grid
pbc             = xyz
rlist           = 1.0

; Electrostatics
coulombtype     = PME
rcoulomb        = 1.0
pme_order       = 4
fourierspacing  = 0.16

; Van der Waals
vdwtype         = Cut-off
rvdw            = 1.0
DispCorr        = EnerPres

; Temperature coupling
tcoupl          = V-rescale     ; Velocity rescaling thermostat
tc-grps         = System        ; Single coupling group
tau_t           = 0.1           ; Time constant (ps)
ref_t           = 300           ; Reference temperature (K)

; Pressure coupling
pcoupl          = no            ; NVT = no pressure coupling

; Velocity generation
gen_vel         = yes           ; Generate velocities
gen_temp        = 300           ; Initial temperature (K)
gen_seed        = -1            ; Random seed

; Constraints
constraints     = h-bonds       ; Constrain bonds with H
constraint_algorithm = LINCS    ; LINCS algorithm
lincs_iter      = 1             ; LINCS iterations
lincs_order     = 4             ; LINCS order
