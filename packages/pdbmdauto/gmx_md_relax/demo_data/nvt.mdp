; nvt.mdp - NVT equilibration (short)
integrator  = md
nsteps      = 500
dt          = 0.002
nstlist     = 10
cutoff-scheme = Verlet
ns_type     = grid
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pbc         = xyz
gen_vel     = yes
gen_temp    = 300
