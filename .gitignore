.DS_Store

# Machine-specific state (tracks which packages are installed locally)
.installed_packages.json

# Per-package dev marker written by the installer / a dev source
**/.installed_from.json

# Pixi environments — built per package on install. Use ** so NESTED multi-node
# packages are covered too, e.g. packages/metalparm-vwf/<node>/.pixi/. The old
# one-level `packages/*/.pixi/` pattern missed these and let build caches slip in.
#
# A package's pixi.lock is NOT ignored since 2026-10-12: a package ships its lock
# when its source tracks one, and the Salpa app builds the environment from it, so
# an install gets the solve that was tested. smiles-to-3d and ligand-pdbqt-meeko
# were the first.
**/.pixi/

# Test / coverage build caches
**/.pytest_cache/
**/.coverage
**/.coverage.*
**/htmlcov/

# Python cache
__pycache__/
*.pyc
*.pyo

# Internal dev notes / handoff — LOCAL only, never published
/dev-notes/

# Incoming package candidates under evaluation — third-party papers, collaborator
# correspondence, feasibility assessments. LOCAL only, never published.
/candidates/

# Claude Code / AI guidance — LOCAL only, not for the public mirror
/CLAUDE.md

# Maintainer tooling — LOCAL only. The public repo ships the product (packages +
# registry + docs); the mirror/audit tooling is run from the working copy.
/Makefile
/MIRRORS.json
/scripts/
